# Copy this to .env and fill in your values.
DATABASE_URL=postgresql://user:password@localhost:5432/resume_db

# Embeddings
NOMIC_API_KEY=...

# Chat completions through Groq's OpenAI-compatible API
GROQ_API_KEY=...
CHAT_MODEL=openai/gpt-oss-120b

# Optional: use local SentenceTransformers embeddings for development.
USE_LOCAL_EMBED=false
